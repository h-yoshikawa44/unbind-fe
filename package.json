{
  "name": "unbind-fe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "cmk",
    "dev": "run-p dev:*",
    "dev:cmk": "cmk --watch",
    "dev:vite": "vp dev",
    "build": "run-s -c generate build:*",
    "build:vite": "tsc -b && vp build",
    "typecheck": "tsc -b --noEmit",
    "lint": "vp check",
    "lint:oxlint": "vp lint",
    "check:oxfmt": "vp fmt --check",
    "fix": "npm run lint -- --fix",
    "fix:oxlint": "npm run lint:oxlint -- --fix",
    "fix:oxfmt": "npm run check:oxfmt -- --write",
    "preview": "vp preview"
  },
  "dependencies": {
    "@hono/inertia": "^0.7.0",
    "@hono/node-server": "^2.1.0",
    "@inertiajs/react": "^3.6.1",
    "@tanstack/react-router": "^1.170.17",
    "hono": "^4.13.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@css-modules-kit/codegen": "^1.4.0",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "npm-run-all2": "^9.0.2",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "^0.2.5",
    "vite-ssr-components": "^0.6.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "packageManager": "npm@11.16.0"
}
