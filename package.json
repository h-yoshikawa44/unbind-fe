{
  "name": "unbind-fe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "cmk",
    "dev": "run-p dev:*",
    "dev:cmk": "cmk --watch",
    "dev:vite": "vp dev",
    "build": "run-s -c generate build:*",
    "build:vite": "tsc -b && vp build",
    "lint": "vp check",
    "lint:oxlint": "vp lint",
    "check:oxfmt": "vp fmt --check",
    "fix": "npm run lint -- --fix",
    "fix:oxlint": "npm run lint:oxlint -- --fix",
    "fix:oxfmt": "npm run check:oxfmt -- --write",
    "preview": "vp preview"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.17",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@css-modules-kit/codegen": "^1.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.13",
    "vite-plus": "0.1.13"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.13",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.13"
  },
  "packageManager": "npm@11.16.0"
}
